# ========================================================
# SUFA / MHFA Production Environment Variables
# Copy file ini menjadi .env di Coolify atau root VPS
# ========================================================

# Database PostgreSQL Lokal (Docker)
POSTGRES_USER=sufa_user
POSTGRES_PASSWORD=sufa_secret_password_change_me
POSTGRES_DB=sufa_db

# Auth & Security
# Generate random 32-char string (e.g. openssl rand -hex 32)
BETTER_AUTH_SECRET=zR8k2PzL9fJ4mB7wY2qX8vN1cT5oP3uK

# URL Aplikasi (PENTING: Gunakan IP VPS dan port jika belum ada domain)
# Contoh: http://103.187.147.20:3000 (JANGAN sertakan trailing slash /)
BETTER_AUTH_URL=http://YOUR_VPS_IP:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://YOUR_VPS_IP:3000

# Secure Cookies
# Set ke false jika masih menggunakan HTTP (IP:port) agar login berfungsi.
# Set ke true setelah menggunakan Domain dan SSL (HTTPS).
USE_SECURE_COOKIES=false

# Port Aplikasi di Host VPS
APP_PORT=3000
